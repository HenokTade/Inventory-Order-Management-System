# ============================================================
# Vercel environment variables — import this file into:
#   Project → Settings → Environment Variables → Import
# (or paste the lines manually). Fill in the <placeholders>.
# ============================================================

# --- Required -------------------------------------------------
# Hosted Postgres (Neon / Supabase / Railway). NOT your local Docker db.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=<generate-a-long-random-string>

# --- First deploy only ---------------------------------------
# Runs `manage.py seed_data` during the build (demo orgs, users,
# products, orders + invoices). DELETE this variable after the
# first successful deploy.
SEED_DATA=true

# --- Daily cron ----------------------------------------------
# Vercel Cron calls GET /api/v1/cron/run/ with
# "Authorization: Bearer <CRON_SECRET>". Random string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=<generate-a-random-string>

# --- Production hosts ----------------------------------------
# Required for Django admin login (CSRF origin check).
CSRF_TRUSTED_ORIGINS=https://YOUR-PROJECT-NAME.vercel.app
# Defaults to * if unset; set it to be strict.
ALLOWED_HOSTS=YOUR-PROJECT-NAME.vercel.app

# --- Optional SMTP (leave commented to log emails to console) -
#EMAIL_HOST=smtp.example.com
#EMAIL_PORT=587
#EMAIL_HOST_USER=apikey-or-username
#EMAIL_HOST_PASSWORD=your-smtp-password
#EMAIL_USE_TLS=true
#DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# --- Not needed on Vercel (defaults already correct) ----------
# REDIS_URL           -> absent = Celery runs inline, cache = memory
# FILE_STORAGE        -> auto "db" (Postgres-backed media) on Vercel
# VITE_API_BASE_URL   -> frontend defaults to /api/v1 (same origin)
# DEBUG               -> defaults to False on Vercel
